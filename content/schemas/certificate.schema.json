{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Certificate",
  "type": "OBJECT",
  "properties": {
    "id": {
      "type": "STRING"
    },
    "courseId": {
      "type": "STRING"
    },
    "studentName": {
      "type": "STRING"
    },
    "issuedAt": {
      "type": "STRING"
    },
    "verificationHash": {
      "type": "STRING"
    },
    "metadata": {
      "type": "OBJECT",
      "properties": {
        "xpEarned": {
          "type": "INTEGER"
        },
        "correctAnswers": {
          "type": "INTEGER"
        }
      },
      "required": ["xpEarned", "correctAnswers"]
    }
  },
  "required": ["id", "courseId", "studentName", "issuedAt", "verificationHash", "metadata"]
}
