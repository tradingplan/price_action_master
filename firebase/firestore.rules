rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /candlesticks/{document} {
      allow create: if false;
      allow read: if true;
      allow write: if request.auth != null;
      allow delete: if false;
    }

    match /figuras/{document} {
      allow create: if false;
      allow read: if true;
      allow write: if request.auth != null;
      allow delete: if false;
    }

    match /conceitos/{document} {
      allow create: if false;
      allow read: if true;
      allow write: if request.auth != null;
      allow delete: if false;
    }

    match /estrategias/{document} {
      allow create: if false;
      allow read: if true;
      allow write: if request.auth != null;
      allow delete: if false;
    }
  }
}
